#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: newenv NAME" >&2
    exit 2
fi

name="$1"

if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "Invalid name: use letters, numbers, '.', '_' or '-'" >&2
    exit 2
fi

project_dir="$HOME/envs/$name"
kernel_dir="$HOME/.local/share/jupyter/kernels/$name"

if [[ -e "$project_dir" ]]; then
    echo "Project already exists: $project_dir" >&2
    exit 1
fi

if [[ -e "$kernel_dir" ]]; then
    echo "Kernel already exists: $kernel_dir" >&2
    exit 1
fi

umask 077

export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-$HOME/.local/share/uv/python}"
export UV_PYTHON_PREFERENCE="${UV_PYTHON_PREFERENCE:-only-managed}"
export UV_LINK_MODE="${UV_LINK_MODE:-copy}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache-${USER}-${SLURM_JOB_ID:-manual}}"

mkdir -p "$HOME/envs" "$UV_CACHE_DIR"
chmod 700 "$UV_CACHE_DIR" || true

python_version="${NEWENV_PYTHON:-3.12}"

uv init --bare --name "$name" "$project_dir"

cd "$project_dir"

uv python install "$python_version"
uv python pin "$python_version"
uv add ipykernel

uv run python -m ipykernel install \
    --user \
    --name "$name" \
    --display-name "Python ($name)"

cat <<EOF

Created:
  $project_dir

Registered kernel:
  Python ($name)

Next:

  cd $project_dir
  uv add apantias
  uv add numpy pandas matplotlib

After changing packages, restart the notebook kernel.

EOF
